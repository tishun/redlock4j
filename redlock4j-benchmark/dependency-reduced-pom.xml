<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.codarama</groupId>
  <artifactId>redlock4j-benchmark</artifactId>
  <name>redlock4j-benchmark</name>
  <version>1.1.0-SNAPSHOT</version>
  <description>Performance benchmarks for redlock4j distributed locking library</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>${benchmark.mainClass}</mainClass>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>org.codarama.redlock4j.benchmark.FairLockBenchmarkMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.2.4.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <spring-integration.version>6.4.10</spring-integration.version>
    <benchmark.mainClass>org.codarama.redlock4j.benchmark.FairLockBenchmarkMain</benchmark.mainClass>
    <redpulsar.version>1.4.0</redpulsar.version>
    <slf4j.version>2.0.9</slf4j.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <jedis.version>7.1.0</jedis.version>
    <shedlock.version>7.7.0</shedlock.version>
    <lettuce.version>7.1.0.RELEASE</lettuce.version>
    <maven.compiler.target>17</maven.compiler.target>
    <testcontainers.version>1.21.4</testcontainers.version>
    <redisson.version>3.46.0</redisson.version>
    <spring-data-redis.version>3.4.4</spring-data-redis.version>
  </properties>
</project>
